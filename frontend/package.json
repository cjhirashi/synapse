{
  "name": "synapse-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.e2e.json",
    "build": "npm run typecheck && vite build",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "test:sync": "scripts/sync-integration.sh",
    "test:sync:perf": "SYNC_PERF=1 scripts/sync-integration.sh",
    "test:perf": "NOTES_PERF=1 vitest run src/notes/tree.perf.test.tsx",
    "test:visual": "scripts/visual.sh",
    "test:bundle": "node scripts/check-bundle.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/lang-sql": "6.10.0",
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/language": "6.13.1",
    "@codemirror/legacy-modes": "6.5.5",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@fontsource/inter": "5.3.0",
    "@lezer/highlight": "1.2.5",
    "@milkdown/core": "7.22.3",
    "@milkdown/ctx": "7.22.3",
    "@milkdown/plugin-clipboard": "7.22.3",
    "@milkdown/plugin-history": "7.22.3",
    "@milkdown/plugin-listener": "7.22.3",
    "@milkdown/preset-commonmark": "7.22.3",
    "@milkdown/preset-gfm": "7.22.3",
    "@milkdown/prose": "7.22.3",
    "events": "3.3.0",
    "lucide-react": "1.61.0",
    "mermaid": "11.17.2",
    "pouchdb-browser": "9.0.0",
    "prosemirror-highlight": "0.16.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.26.2",
    "svg-pan-zoom": "3.6.2",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@playwright/test": "1.56.0",
    "@testing-library/jest-dom": "6.5.0",
    "@testing-library/react": "16.0.1",
    "@testing-library/user-event": "14.5.2",
    "@types/node": "20.19.43",
    "@types/pouchdb-adapter-memory": "6.1.6",
    "@types/pouchdb-browser": "6.1.5",
    "@types/react": "18.3.11",
    "@types/react-dom": "18.3.0",
    "@vitejs/plugin-react": "4.3.2",
    "@vitest/coverage-v8": "2.1.2",
    "jsdom": "25.0.1",
    "pouchdb-adapter-memory": "9.0.0",
    "typescript": "5.6.2",
    "vite": "5.4.8",
    "vitest": "2.1.2"
  }
}
