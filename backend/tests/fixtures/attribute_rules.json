{
 "_doc": "H-029: especificación compartida de atributos META. La implementan backend (Python) y frontend (TypeScript); ambos deben pasar TODOS estos casos. Cada sección define su algoritmo en 'rule'.",
 "limits": {
  "titulo_max": 200,
  "descripcion_max": 1000,
  "tags_max": 20,
  "tag_max_len": 32
 },
 "estados": [
  "borrador",
  "en_proceso",
  "en_revision",
  "vigente",
  "archivado"
 ],
 "reserved_keys": [
  "ruta",
  "fecha_creacion",
  "fecha_actualizacion"
 ],
 "normalize_key": {
  "rule": "NFD, quitar marcas diacríticas, minúsculas, cada racha de caracteres que no sean [a-z0-9] pasa a '_', recortar '_' de los extremos; si queda vacía, null.",
  "cases": [
   [
    "título",
    "titulo"
   ],
   [
    "Fecha creación",
    "fecha_creacion"
   ],
   [
    "fecha_creación",
    "fecha_creacion"
   ],
   [
    "última_actualización",
    "ultima_actualizacion"
   ],
   [
    "Estado",
    "estado"
   ],
   [
    "año",
    "ano"
   ],
   [
    "Valor 1",
    "valor_1"
   ],
   [
    "  mi  clave  ",
    "mi_clave"
   ],
   [
    "a-b/c",
    "a_b_c"
   ],
   [
    "___",
    null
   ],
   [
    "",
    null
   ],
   [
    "ÑANDÚ",
    "nandu"
   ]
  ]
 },
 "normalize_tag": {
  "rule": "NFC, recortar, minúsculas, cada racha de caracteres que no sea letra Unicode, dígito, '-' o '_' pasa a '_', recortar '_' y '-' de los extremos, cortar a 32 caracteres y volver a recortar '_' y '-' del final; si queda vacío, null. Las letras con acento se conservan.",
  "cases": [
   [
    "Mi Tag",
    "mi_tag"
   ],
   [
    "IA",
    "ia"
   ],
   [
    "CLAUDE.md",
    "claude_md"
   ],
   [
    "tr-##",
    "tr"
   ],
   [
    "análisis",
    "análisis"
   ],
   [
    "proyecto/synapse",
    "proyecto_synapse"
   ],
   [
    "  x  ",
    "x"
   ],
   [
    "###",
    null
   ],
   [
    "",
    null
   ],
   [
    "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
    "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
   ],
   [
    "año-2026",
    "año-2026"
   ],
   [
    "a  b   c",
    "a_b_c"
   ],
   [
    "_inicio",
    "inicio"
   ],
   [
    "fin-",
    "fin"
   ]
  ]
 },
 "estado_synonyms": {
  "rule": "Se busca el valor (cadena) normalizado: recortar, minúsculas, quitar acentos, cada racha de espacios, '-' o '_' pasa a un espacio. Si está en la tabla, el estado es su código; si no, 'estado' no se escribe y el valor original queda en 'estado_original'.",
  "table": {
   "active": "vigente",
   "activo": "vigente",
   "vigente": "vigente",
   "draft": "borrador",
   "borrador": "borrador",
   "en revision": "en_revision",
   "revision": "en_revision",
   "archived": "archivado",
   "archivado": "archivado",
   "superseded": "archivado",
   "en proceso": "en_proceso",
   "en progreso": "en_proceso"
  },
  "cases": [
