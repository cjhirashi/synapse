    "active",
    "vigente"
   ],
   [
    "Activo",
    "vigente"
   ],
   [
    "en revisión",
    "en_revision"
   ],
   [
    "en-revisión",
    "en_revision"
   ],
   [
    "en_revision",
    "en_revision"
   ],
   [
    "draft",
    "borrador"
   ],
   [
    "archived",
    "archivado"
   ],
   [
    "superseded",
    "archivado"
   ],
   [
    "publicado",
    null
   ],
   [
    "",
    null
   ],
   [
    "en-proceso",
    "en_proceso"
   ],
   [
    "En proceso",
    "en_proceso"
   ],
   [
