# PostgreSQL — control plane de Synapse
POSTGRES_USER=synapse
POSTGRES_PASSWORD=           # generar: openssl rand -base64 32
POSTGRES_DB=synapse_control

# CouchDB — documentos por usuario
COUCHDB_URL=http://couchdb:5984
COUCHDB_USER=admin
COUCHDB_PASSWORD=            # generar: openssl rand -base64 32

# JWT — generar: openssl rand -base64 64 (obligatorio: sin él el backend no arranca)
JWT_SECRET=

# Admin sembrado al arrancar (SPEC-0002 RF-001). Obligatorios.
# La contraseña es semilla: se exige cambiarla en el primer ingreso.
ADMIN_EMAIL=cjhirashi@gmail.com
ADMIN_PASSWORD=              # contraseña semilla; nunca la versiones

# MinIO (archivos subidos, H-015/H-016)
MINIO_ROOT_USER=            # usuario root de MinIO
MINIO_ROOT_PASSWORD=        # generar: openssl rand -base64 32
# MINIO_ENDPOINT y MINIO_BUCKET tienen valor por defecto (synapse-minio:9000, synapse-files)

# Dominio
SYNAPSE_DOMAIN=synapse.tudominio.com

# Deploy mode: local | cloud
HIRA_DEPLOY_MODE=local
