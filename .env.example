# PostgreSQL — control plane de Synapse
POSTGRES_USER=synapse
POSTGRES_PASSWORD=           # generar: openssl rand -base64 32
POSTGRES_DB=synapse_control

# CouchDB — documentos por usuario
COUCHDB_USER=admin
COUCHDB_PASSWORD=            # generar: openssl rand -base64 32

# Qdrant — vectores RAG
QDRANT_API_KEY=              # generar: openssl rand -hex 32

# LiteLLM — modelos externos
ANTHROPIC_API_KEY=           # desde console.anthropic.com
OPENROUTER_API_KEY=          # desde openrouter.ai

# Ollama — modelo local (red interna Docker)
OLLAMA_BASE_URL=http://ollama:11434

# OpenAI — TTS + Whisper STT
OPENAI_API_KEY=              # desde platform.openai.com

# Tavily — búsqueda web para agentes
TAVILY_API_KEY=              # desde tavily.com

# JWT — generar: openssl rand -base64 64
JWT_SECRET=

# Dominio
SYNAPSE_DOMAIN=synapse.tudominio.com

# Deploy mode: local | cloud
HIRA_DEPLOY_MODE=local
