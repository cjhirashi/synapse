{
  "readFiles": [
    "CLAUDE.md",
    "AGENTS.md",
    ".harness/constitution.md",
    ".harness/method.md",
    ".harness/memory/state.md",
    ".harness/specs/",
    "src/backend/",
    "src/frontend/"
  ],
  "ignorePatterns": [
    "node_modules/",
    "venv/",
    "dist/",
    ".git/",
    ".env",
    "__pycache__/",
    "*.pyc",
    "build/",
    ".vite/"
  ],
  "tools": {
    "allowed": ["Bash", "Read", "Edit", "Write", "Agent"],
    "restrictions": {
      "Bash": "Sin --no-verify ni --force-push. Tests con BD real (P5). Datos aislados por user_id (P2)."
    }
  },
  "skills": {
    "archify": {
      "enabled": true,
      "use_cases": [
        "Flujo sincronización PouchDB ↔ CouchDB (SPEC-0005)",
        "Arquitectura monolito por capas (ADR-001)",
        "Flujo JWT + autorización",
        "Modelo datos vault+documents"
      ],
      "output_path": ".harness/diagrams/",
      "format": "json"
    }
  },
  "context_gates": {
    "before_touching_code": [
      "Lee .harness/memory/state.md (correcciones del usuario)",
      "Aplica rúbrica de method.md §2",
      "¿Hay spec.md que lo cubra? Si no → carril SDD Specify"
    ],
    "after_each_session": [
      "Actualiza .harness/memory/history.md con Session-End",
      "Gate: check.sh debe pasar",
      "Registra rebotes, decisiones, próximo paso"
    ]
  }
}
